# Database (Neon connection string)
DATABASE_URL="postgresql://user:password@host.neon.tech/walking_mountains?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Claude AI
ANTHROPIC_API_KEY="sk-ant-..."

# Frontend (web only — set in Cloudflare Pages env vars)
VITE_API_URL=https://your-api.onrender.com

# App
API_PORT=3001
API_HOST="0.0.0.0"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
